stage('Checkout') {
    steps {
        echo '📥 Clonage du dépôt GitHub...'
        bat '''
        git init
        git remote add origin https://github.com/ElEchIheb/2AWI-G3-gestion_projet-spring.git
        git fetch origin AhmedBENYOUNES-AWI2-G3
        git checkout -b AhmedBENYOUNES-AWI2-G3 origin/AhmedBENYOUNES-AWI2-G3
        '''
    }
}
